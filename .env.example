# NOVA — API Keys and Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini (Primary LLM)
# Get your key at: https://ai.google.dev
NOVA_GEMINI_API_KEY=your_key_here

# Groq (Primary STT + Fallback LLM)
# Get your key at: https://console.groq.com
NOVA_GROQ_API_KEY=your_key_here

# Cloudflare Workers AI (Fallback STT/LLM/TTS)
# Get your credentials at: https://dash.cloudflare.com
NOVA_CLOUDFLARE_ACCOUNT_ID=your_id_here
NOVA_CLOUDFLARE_API_TOKEN=your_token_here

# Google Cloud TTS (Primary TTS — Chirp 3 HD voices)
# Create a service account at: https://console.cloud.google.com
# Enable Cloud Text-to-Speech API and download the JSON key file
NOVA_GOOGLE_CLOUD_TTS_KEY_PATH=

#Menonafktifkan Clap Detection
NOVA_CLAP_DETECTION_ENABLED=false

# Tuya
TUYA_ACCESS_ID=<Access ID dari iot.tuya.com>
TUYA_ACCESS_KEY=<Access Secret dari iot.tuya.com>
TUYA_REGION=<region kamu: us/eu/cn/in>

# LG TV
LG_TV_ATAS_IP=192.168.x.x
LG_TV_ATAS_CLIENT_KEY=  # Auto-populated after first pairing
LG_TV_BAWAH_IP=192.168.x.x
LG_TV_BAWAH_CLIENT_KEY=  # Auto-populated after first pairing

# Messaging
NOVA_WHATSAPP_ENABLED=true
NOVA_WHATSAPP_ALLOWED_JIDS=[""]
NOVA_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
NOVA_TELEGRAM_ALLOWED_USERS=[123456789]